# TLS termination in front of the api container (docker-compose publishes it on 127.0.0.1:8100).
# Certificates: certbot --nginx -d create-task.ru
#
# With this setup uvicorn sees requests from the Docker gateway address, so set
# FORWARDED_ALLOW_IPS in .env to that address (e.g. 172.17.0.1) for per-IP rate limits.

server {
    listen 80;
    server_name create-task.ru;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name create-task.ru;

    ssl_certificate     /etc/letsencrypt/live/create-task.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/create-task.ru/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    add_header Strict-Transport-Security "max-age=31536000" always;

    client_max_body_size 1m;

    location /api/agent/ws {
        proxy_pass http://127.0.0.1:8100;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        # Must exceed the 20s WebSocket ping interval.
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    location / {
        proxy_pass http://127.0.0.1:8100;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }
}
