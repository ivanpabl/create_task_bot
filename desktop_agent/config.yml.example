# Discord Task Bot — Desktop Agent Configuration
# Normally you don't edit this file: download the agent from the site (config is
# pre-filled), or leave agent_token empty and enter a pairing code on first launch.

# Backend URL. Must be https:// (http:// is allowed only for localhost).
backend_url: "https://create-task.ru"

# Personal credential issued by the site. Do not share it.
# agent_token: ""

# Whisper model settings (optional)
# whisper_model: "medium"     # tiny, base, small, medium, large-v3 (medium — баланс качества и размера)
# whisper_device: "cpu"       # cpu or cuda
# whisper_compute: "int8"     # int8, float16, float32
